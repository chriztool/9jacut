# What goes into 9jaCut's iPhone copy of FFmpeg. Changing this file and
# pushing to the `ios` branch rebuilds it (.github/workflows/build-ffmpeg-ios.yml)
# and publishes it as the GitHub release named by FFMPEG_IOS_RELEASE.
#
# LGPL only (no --enable-gpl, no x264) so the app can go on the App Store.
# Video is encoded with Apple's hardware encoder (h264_videotoolbox).
# freetype is needed for the drawtext filter: text, captions and promo videos.

# Bump this whenever the options below change.
FFMPEG_IOS_RELEASE=ffmpeg-ios-lgpl-1

# github.com/jaywcjlove/ffmpeg-kit (Swift FFmpegKit fork), pinned.
FFMPEG_KIT_REPO=https://github.com/jaywcjlove/ffmpeg-kit
FFMPEG_KIT_COMMIT=0243a6a262944e2e6cd1dd9603122108594d182a

FFMPEG_KIT_OPTIONS="--enable-freetype --enable-ios-videotoolbox --enable-ios-audiotoolbox --enable-ios-zlib --enable-ios-bzip2 --enable-ios-libiconv --disable-x86-64 --target=15.0"
