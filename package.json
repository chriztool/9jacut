{
  "name": "9jacut",
  "version": "2.0.0",
  "description": "9jacut — free video editor: clips, reframing, captions, effects and promo videos",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "test": "node test/export-test.js",
    "dist": "electron-builder --win",
    "build:mobile": "node scripts/build-mobile.js",
    "ios:sync": "node scripts/build-mobile.js && npx cap sync ios",
    "test:mobile": "node scripts/build-mobile.js && electron test/mobile-bridge-test.js"
  },
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@capacitor/cli": "^8.5.2",
    "@capacitor/core": "^8.5.2",
    "@capacitor/filesystem": "^8.1.4",
    "@capacitor/ios": "^8.5.2",
    "@capacitor/share": "^8.0.3",
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3"
  },
  "dependencies": {
    "ffmpeg-static": "^5.2.0",
    "sherpa-onnx-node": "^1.13.8",
    "tar-stream": "^3.2.1",
    "unbzip2-stream": "^1.4.3"
  },
  "build": {
    "appId": "com.ninejacut.app",
    "productName": "9jacut",
    "files": [
      "main.js",
      "preload.js",
      "promo-templates.js",
      "promo-export.js",
      "clip-export.js",
      "captions.js",
      "renderer/**/*",
      "assets/**/*",
      "node_modules/**/*"
    ],
    "asarUnpack": [
      "node_modules/ffmpeg-static/**/*",
      "assets/stickers/**/*",
      "assets/fonts/**/*",
      "node_modules/sherpa-onnx-*/**"
    ],
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico"
    },
    "portable": {
      "artifactName": "9jacut.exe"
    }
  }
}
